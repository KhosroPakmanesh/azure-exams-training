# Microsoft Foundry credentials for ALL eight apps. Edit the values below.
# Use the Azure OpenAI resource endpoint, not a /api/projects/ endpoint.
# Example: https://your-resource.openai.azure.com/
AZURE_OPENAI_ENDPOINT=

# Exact model deployment name shown in Foundry.
MODEL_DEPLOYMENT=

# Paste your Azure OpenAI resource API key below, OR leave blank to use az login.
AZURE_OPENAI_API_KEY=

# Optional. Leave blank to use the default system instructions.
SYSTEM_INSTRUCTIONS=
